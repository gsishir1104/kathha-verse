# Used by Docker Compose. Copy to .env and supply your own values.
# Use a URL-safe random password (letters and digits) for the composed DB URL.
POSTGRES_PASSWORD=replace_with_a_long_random_password
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Production uses the hosted provider. Keep this secret only on the API server.
AI_PROVIDER=openai
# Cost controls shared by every AI feature (per UTC day).
AI_DAILY_LIMIT=5
AI_SHARED_DAILY_LIMIT=30
# Set production only when accessed through HTTPS. It enables Secure cookies.
APP_ENV=development
FRONTEND_ORIGINS=http://127.0.0.1:8000
# For direct Python execution (not Compose):
# DATABASE_URL=postgresql+psycopg://storylens:password@localhost:5432/storylens
# DEMO_MODE=false

# Optional local development provider. Set AI_PROVIDER=ollama to use it:
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma3:4b

# Welcome emails. Enable only after configuring your verified Storylens sender.
MAIL_ENABLED=false
MAIL_FROM_ADDRESS=
PUBLIC_APP_URL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
# Gmail app password (not your normal password); keep privately on the server.
SMTP_PASSWORD=

# Fill these only after creating and confirming your Gmail accounts.
# MAIL_FROM_ADDRESS and SMTP_USERNAME must match your welcome Gmail address.
SUPPORT_EMAIL=

# Google Cloud OAuth web application credentials. Never expose the secret.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Authorized redirect URI: PUBLIC_APP_URL + /api/auth/google/callback

# Comma-separated existing user IDs; never selectable during signup.
ADMIN_USER_IDS=

# Optional staff IDs, distinct from owner ADMIN_USER_IDS.
STAFF_SUPPORT_IDS=
STAFF_MODERATOR_IDS=
STAFF_TECHNICAL_IDS=
